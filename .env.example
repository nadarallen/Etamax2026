# ==========================================
# ETAMAX 2026 ENVIRONMENT CONFIGURATION TEMPLATE
# Rename this file to .env.local and fill in the values
# ==========================================

# 1. Database (MongoDB Atlas or Local MongoDB)
# For Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
# For local development: mongodb://localhost:27017/etamax_prod
MONGODB_URI=mongodb+srv://your_mongodb_username:your_mongodb_password@cluster0.example.mongodb.net/etamax2026?retryWrites=true&w=majority

# 2. Authentication & Security (JWT & NextAuth)
# Generate secure secrets with: openssl rand -base64 32 or openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_please_change_this
NEXTAUTH_SECRET=your_nextauth_secret_key_please_change_this
NEXTAUTH_URL=http://localhost:3000

# 3. Payment Gateway (Razorpay)
# Retrieve keys from Razorpay Dashboard -> Settings -> API Keys (Test mode or Live mode)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Public Key for Frontend (Must match RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# 4. Security & Rate Limiting (Upstash Redis)
# Create a free Redis instance at https://console.upstash.com/ for API rate limiting
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token

# 5. Background Jobs (Cron)
# Secret required to trigger background cleanup jobs (e.g. /api/cron/cleanup) securely
CRON_SECRET=your_cron_secret_key

# 6. Global Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 7. Email Configuration (Nodemailer SMTP)
# Primary Email Account configuration (e.g. Hostinger SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_primary_email@domain.com
EMAIL_PASS=your_primary_email_password

# Backup Email Account configuration (e.g. Gmail fallback SMTP)
EMAIL_USER_2=your_backup_email@gmail.com
EMAIL_PASS_2=your_backup_gmail_app_password

# 8. Development Bypass Codes (Optional)
# Codes used to bypass Razorpay payment during development testing
PAYMENT_BYPASS_CODE=your_secret_dev_bypass_code
NEXT_PUBLIC_PAYMENT_BYPASS_CODE=your_secret_dev_bypass_code
