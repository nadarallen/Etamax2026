# Production Environment Variables
# Copy this file to .env.production or .env on your VPS

# Server
PORT=3000
NODE_ENV=production

# Database
# If using the docker-compose mongo service:
MONGODB_URI=mongodb://mongo:27017/etamax_prod
# If using an external MongoDB (e.g., Atlas):
# MONGODB_URI=mongodb+srv://...

# App Config
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXTAUTH_URL=https://your-domain.com

# Auth Secrets (Generate new ones for production)
# You can generate one using: openssl rand -base64 32
NEXTAUTH_SECRET=changeme_in_production

# Other API Keys
# ...
